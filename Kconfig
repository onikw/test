#
# App Kconfig
#

source "Kconfig.zephyr"

menu "App settings"

config APP_WIFI_SSID
	string "WiFi SSID"
	default "SLUMSY"

config APP_WIFI_PSK
	string "WiFi password (WPA2-PSK)"
	default "ujnakolana"

config APP_SERVER_HOST
	string "HTTPS server hostname (or IPv4)"
	default "virgin-classifieds-wheel-hey.trycloudflare.com"
	help
	  Hostname (FQDN) or IPv4 address of the Mjolnir ingest server.
	  When a hostname is used, mbedtls SNI + cert validation uses it.

config APP_SERVER_PORT
	int "HTTPS server port"
	default 443

config APP_SERVER_URL_PATH
	string "Ingest URL path"
	default "/api/mjolnir/ingest"

config APP_MJOLNIR_API_KEY
	string "Factory-burned Mjolnir API key"
	default "mjlnr_b042769922b73b6e1f6674154a3d340de336b1e229e6075c"
	help
	  Sent as X-Mjolnir-Key header. Identifies the specific hammer row
	  on the server; user pairs by serial, never by key.

config APP_DEVICE_ID
	string "Device chip id (echoed in request body)"
	default "nrf7002dk"

config APP_POST_INTERVAL_S
	int "POST interval (seconds)"
	default 5

config APP_BLE_TARGET_MAC
	string "BLE target peripheral MAC (xx:xx:xx:xx:xx:xx)"
	default "c7:f1:ec:f8:d0:b6"
	help
	  Adres MAC peryferalu BLE z ktorym ma sie laczyc nasza centrala.
	  Pusty string = nie probuj sie laczyc (BLE wylaczone w runtime).
	  Format: AA:BB:CC:DD:EE:FF (case-insensitive).

config APP_BLE_TARGET_MAC_TYPE
	string "BLE target address type (public|random)"
	default "random"
	help
	  Wiekszosc consumer-grade urzadzen BLE uzywa adresow random.

endmenu
